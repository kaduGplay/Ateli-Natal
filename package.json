{
  "name": "atelie-natal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loja Ateli\u00ea Natal em TypeScript (API Express + front-end tipado)",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test:payments": "npm run build:server && node --test tests/payments.test.mjs",
    "sync": "node scripts/sync-github.mjs",
    "verify": "npm run typecheck && npm run build && npm run test:payments"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.1",
    "@vercel/functions": "^3.9.8",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "22.x"
  }
}
